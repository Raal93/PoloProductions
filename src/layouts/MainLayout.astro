---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/reset.css';
import '../styles/variables.css';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'Polo Productions — Cinematic Wedding Films',
  description = 'Cinematic wedding films. Uwieczniam najpiękniejszy dzień Waszego życia.',
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
