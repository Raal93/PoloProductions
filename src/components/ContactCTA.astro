---
---

<section class="cta-contact" id="kontakt">
  <div class="cta-contact__ambient" aria-hidden="true"></div>
  <div class="container">
    <div class="cta-contact__layout">

      <div class="cta-contact__intro">
        <span class="cta-contact__label">Kontakt</span>
        <h2 class="cta-contact__title">Opowiedz mi<br />o swoim dniu.</h2>
        <p class="cta-contact__desc">
          Napisz datę ślubu, miejsce i kilka zdań o tym, jaki klimat filmu
          jest Wam najbliższy. Odpowiem z dostępnością i propozycją zakresu realizacji.
        </p>
        <div class="cta-contact__links">
          <a
            href="https://instagram.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-contact__link"
            aria-label="Instagram Polo Productions"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            Instagram
          </a>
          <a
            href="mailto:kontakt@poloproductions.pl"
            class="cta-contact__link"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            kontakt@poloproductions.pl
          </a>
          <a href="tel:+48000000000" class="cta-contact__link">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13 19.79 19.79 0 0 1 1.61 4.41 2 2 0 0 1 3.6 2.22h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.09 6.09l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            +48 000 000 000
          </a>
        </div>
      </div>

      <form class="cta-form" novalidate>
        <div class="cta-form__field">
          <label for="cf-name" class="cta-form__label">Imię</label>
          <input
            type="text"
            id="cf-name"
            name="name"
            class="cta-form__input"
            placeholder="Marta"
            autocomplete="given-name"
          />
        </div>
        <div class="cta-form__field">
          <label for="cf-email" class="cta-form__label">Email</label>
          <input
            type="email"
            id="cf-email"
            name="email"
            class="cta-form__input"
            placeholder="marta@email.pl"
            autocomplete="email"
          />
        </div>
        <div class="cta-form__field">
          <label for="cf-wedding" class="cta-form__label">Data i miejsce ślubu</label>
          <input
            type="text"
            id="cf-wedding"
            name="wedding"
            class="cta-form__input"
            placeholder="12 lipca 2026, Kraków"
          />
        </div>
        <div class="cta-form__field">
          <label for="cf-message" class="cta-form__label">Wiadomość</label>
          <textarea
            id="cf-message"
            name="message"
            class="cta-form__textarea"
            rows="4"
            placeholder="Kilka zdań o planowanym dniu i klimacie, jaki jest Wam bliski..."
          ></textarea>
        </div>
        <button type="submit" class="btn btn--primary cta-form__submit">
          Wyślij zapytanie
        </button>
      </form>

    </div>
  </div>
</section>

<style>
.cta-contact {
  background-color: var(--color-surface);
  position: relative;
  overflow: hidden;
}

.cta-contact__ambient {
  position: absolute;
  bottom: -100px;
  left: -100px;
  width: 600px;
  height: 600px;
  background: radial-gradient(
    ellipse at center,
    rgba(198, 164, 106, 0.05) 0%,
    transparent 60%
  );
  pointer-events: none;
}

.cta-contact__layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4rem;
  position: relative;
}

@media (min-width: 769px) {
  .cta-contact__layout {
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: start;
  }
}

.cta-contact__label {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 1rem;
}

.cta-contact__title {
  font-family: var(--font-serif);
  font-size: clamp(2.25rem, 5vw, 3.5rem);
  font-weight: 400;
  color: var(--color-text);
  line-height: 1.08;
  margin-bottom: 1.5rem;
}

.cta-contact__desc {
  font-size: 0.95rem;
  color: var(--color-muted);
  line-height: 1.85;
  margin-bottom: 2.5rem;
  max-width: 38ch;
}

.cta-contact__links {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.cta-contact__link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.875rem;
  color: var(--color-muted);
  text-decoration: none;
  transition: color 180ms ease;
}

.cta-contact__link:hover {
  color: var(--color-accent);
}

/* ——— Form ——— */
.cta-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.cta-form__field {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.cta-form__label {
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.cta-form__input,
.cta-form__textarea {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  padding: 0.85rem 1rem;
  font-family: var(--font-sans);
  font-size: 0.95rem;
  color: var(--color-text);
  width: 100%;
  transition: border-color 180ms ease, background 180ms ease;
}

.cta-form__input::placeholder,
.cta-form__textarea::placeholder {
  color: rgba(168, 160, 150, 0.35);
}

.cta-form__input:focus,
.cta-form__textarea:focus {
  outline: none;
  border-color: rgba(198, 164, 106, 0.5);
  background: rgba(255, 255, 255, 0.06);
}

.cta-form__textarea {
  resize: vertical;
  min-height: 120px;
}

.cta-form__submit {
  align-self: flex-start;
  margin-top: 0.5rem;
}
</style>
