---
const services = [
  { name: 'Film ślubny', note: 'pełna historia' },
  { name: 'Teaser ślubny', note: 'krótka forma' },
  { name: 'Ujęcia z drona', note: 'perspektywa z góry' },
  { name: 'Reportaż eventowy', note: 'imprezy i eventy' },
  { name: 'Film dla marki', note: 'produkcje komercyjne' },
  { name: 'Reels / social video', note: 'content na social media' },
];
---

<section class="services">
  <div class="container">
    <div class="services__layout">
      <div class="services__intro">
        <span class="services__label">Realizacje</span>
        <h2 class="services__title">Zakres<br />pracy</h2>
        <p class="services__text">
          Najczęściej pracuję z parami, które szukają filmu ślubnego w spokojnym,
          eleganckim i ponadczasowym stylu. Realizuję też krótkie formy dla marek,
          wydarzeń i social mediów, jeśli projekt pasuje do mojego sposobu pracy.
        </p>
      </div>
      <ul class="services__list" role="list">
        {services.map((s) => (
          <li class="services__item">
            <span class="services__name">{s.name}</span>
            <span class="services__note">{s.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
.services {
  background-color: var(--color-surface);
}

.services__layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
}

@media (min-width: 769px) {
  .services__layout {
    grid-template-columns: 5fr 7fr;
    gap: 6rem;
    align-items: start;
  }
}

.services__label {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 1rem;
}

.services__title {
  font-family: var(--font-serif);
  font-size: clamp(2.25rem, 5vw, 3.5rem);
  font-weight: 400;
  color: var(--color-text);
  line-height: 1.08;
  margin-bottom: 1.5rem;
}

.services__text {
  font-size: 0.95rem;
  color: var(--color-muted);
  line-height: 1.85;
  max-width: 36ch;
}

.services__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
}

.services__item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  padding-block: 1.15rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  transition: padding-left 200ms ease;
  cursor: default;
}

.services__item:first-child {
  border-top: 1px solid rgba(255, 255, 255, 0.07);
}

.services__item:hover {
  padding-left: 0.5rem;
}

.services__name {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  font-weight: 400;
  color: var(--color-text);
  transition: color 200ms ease;
}

.services__item:hover .services__name {
  color: var(--color-accent);
}

.services__note {
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-muted);
  flex-shrink: 0;
}
</style>
