---
import MainLayout from '../../layouts/MainLayout.astro';
import { mockFilms } from '../../data/mockFilms';
import type { FilmProject } from '../../data/mockFilms';

export function getStaticPaths() {
  return mockFilms.map((film) => ({
    params: { slug: film.slug },
    props: { film },
  }));
}

type Props = {
  film: FilmProject;
};

const { film } = Astro.props;
---

<MainLayout title={`${film.title} — Polo Productions`}>
  <article class="film-page">
    <div class="film-page__hero">
      <div class="film-page__hero-bg"></div>
      <div class="film-page__hero-content">
        <p class="film-page__location">{film.location}</p>
        <h1 class="film-page__title">{film.title}</h1>
      </div>
    </div>
    <div class="container film-page__body">
      <p class="film-page__excerpt">{film.excerpt}</p>
      <a href="/portfolio" class="film-page__back">← Wróć do portfolio</a>
    </div>
  </article>
</MainLayout>

<style>
.film-page__hero {
  position: relative;
  height: 70vh;
  display: flex;
  align-items: flex-end;
  padding-bottom: 4rem;
}

.film-page__hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2218 50%, #1a1210 100%);
}

.film-page__hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(13, 13, 13, 0.9) 0%, rgba(13, 13, 13, 0.2) 60%);
}

.film-page__hero-content {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: var(--container-width);
  margin-inline: auto;
  padding-inline: 1.5rem;
}

.film-page__location {
  font-size: 0.75rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 0.75rem;
}

.film-page__title {
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 400;
  color: var(--color-text);
}

.film-page__body {
  padding-block: 4rem;
}

.film-page__excerpt {
  font-size: 1.15rem;
  color: var(--color-muted);
  line-height: 1.8;
  max-width: 60ch;
  margin-bottom: 3rem;
}

.film-page__back {
  font-size: 0.875rem;
  color: var(--color-muted);
  letter-spacing: 0.05em;
  transition: color var(--transition-base);
}

.film-page__back:hover {
  color: var(--color-accent);
}
</style>
