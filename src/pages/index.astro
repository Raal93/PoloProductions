---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FilmCard from '../components/FilmCard.astro';
import { mockFilms } from '../data/mockFilms';

const featuredFilms = mockFilms.filter((film) => film.featured);

const processSteps = [
  {
    number: '01',
    title: 'Poznanie',
    description: 'Zaczynamy od rozmowy. Chcę poznać Waszą historię, styl i marzenia o weselu.',
  },
  {
    number: '02',
    title: 'Planowanie',
    description: 'Razem ustalamy harmonogram dnia i kluczowe momenty, które chcecie zachować na zawsze.',
  },
  {
    number: '03',
    title: 'Film',
    description: 'W dniu ślubu jestem niewidoczny — rejestruję autentyczne emocje bez inscenizacji.',
  },
  {
    number: '04',
    title: 'Wspomnienie',
    description: 'Otrzymujecie gotowy film, który będziecie oglądać przez kolejne dekady.',
  },
];

const testimonials = [
  {
    quote:
      'Polo Productions uchwycił magię naszego ślubu w sposób, który nas oniemiela za każdym razem, gdy oglądamy film.',
    author: 'Marta & Tomasz',
    location: 'Kraków',
  },
  {
    quote:
      'Profesjonalizm, wyczucie estetyki i ciepło — tak opisujemy współpracę. Film jest absolutnie piękny.',
    author: 'Zofia & Michał',
    location: 'Gdańsk',
  },
  {
    quote:
      'Nie spodziewaliśmy się, że można w tak poetycki sposób opowiedzieć historię jednego dnia.',
    author: 'Anna & Piotr',
    location: 'Warszawa',
  },
];
---

<MainLayout title="Polo Productions — Cinematic Wedding Films">

  <Hero />

  <!-- ——— Featured Films ——— -->
  <section class="featured-films">
    <div class="container">
      <SectionHeader
        label="Portfolio"
        title="Wybrane filmy"
        subtitle="Każda para ma swoją wyjątkową historię. Oto niektóre z nich."
      />
      <div class="featured-films__grid">
        {featuredFilms.map((film) => (
          <FilmCard film={film} />
        ))}
      </div>
      <div class="featured-films__cta">
        <a href="/portfolio" class="btn btn--ghost">Zobacz wszystkie filmy</a>
      </div>
    </div>
  </section>

  <!-- ——— About ——— -->
  <section class="about">
    <div class="container about__inner">
      <div class="about__image-wrap">
        <div class="about__image-placeholder"></div>
      </div>
      <div class="about__text">
        <SectionHeader
          label="O mnie"
          title="Opowiadam historię, nie kręcę klipów"
        />
        <p class="about__body">
          Wierzę, że film ślubny powinien być więcej niż montaż zdjęć przy muzyce.
          Podchodzę do każdego wesela jak reżyser — z wyczuciem narracji, światła i emocji.
        </p>
        <p class="about__body">
          Pracuję dyskretnie, by uchwycić to, co autentyczne. Nie inscenizuję. Nie wymuszam.
          Czekam na właściwy moment i go zamrażam.
        </p>
        <div class="about__action">
          <a href="/o-mnie" class="btn btn--ghost">Poznaj mnie bliżej</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ——— Process ——— -->
  <section class="process">
    <div class="container">
      <SectionHeader
        label="Jak pracuję"
        title="Prosty proces, wyjątkowy rezultat"
        align="center"
      />
      <div class="process__steps">
        {processSteps.map((step) => (
          <div class="process__step">
            <span class="process__number">{step.number}</span>
            <h3 class="process__title">{step.title}</h3>
            <p class="process__desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ——— Testimonials ——— -->
  <section class="testimonials">
    <div class="container">
      <SectionHeader
        label="Opinie"
        title="Co mówią pary"
        align="center"
      />
      <div class="testimonials__grid">
        {testimonials.map((t) => (
          <blockquote class="testimonial">
            <p class="testimonial__quote">„{t.quote}"</p>
            <footer class="testimonial__footer">
              <strong class="testimonial__author">{t.author}</strong>
              <span class="testimonial__location">{t.location}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ——— Contact CTA ——— -->
  <section class="contact-cta">
    <div class="container contact-cta__inner">
      <span class="contact-cta__label">Zarezerwuj termin</span>
      <h2 class="contact-cta__title">Gotowi, by uwiecznić<br />Wasz dzień?</h2>
      <p class="contact-cta__subtitle">
        Terminy na 2025–2026 wypełniają się szybko. Napisz już dziś.
      </p>
      <a href="/kontakt" class="btn btn--primary btn--large">Napisz do mnie</a>
    </div>
  </section>

</MainLayout>

<style>
/* ——— Featured Films ——— */
.featured-films__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
}

.featured-films__cta {
  margin-top: 3rem;
  text-align: center;
}

/* ——— About ——— */
.about {
  background-color: var(--color-surface);
}

.about__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}

.about__image-wrap {
  border-radius: var(--radius-md);
  overflow: hidden;
  aspect-ratio: 4 / 5;
}

.about__image-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1a1a1a 0%, #2a2218 55%, #1a1210 100%);
}

.about__body {
  color: var(--color-muted);
  line-height: 1.8;
  margin-bottom: 1rem;
}

.about__action {
  margin-top: 1.75rem;
}

@media (max-width: 768px) {
  .about__inner {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}

/* ——— Process ——— */
.process__steps {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2rem;
}

.process__step {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 1.5rem;
}

.process__number {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  color: var(--color-accent);
  margin-bottom: 1rem;
}

.process__title {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--color-text);
  margin-bottom: 0.75rem;
}

.process__desc {
  font-size: 0.875rem;
  color: var(--color-muted);
  line-height: 1.75;
}

/* ——— Testimonials ——— */
.testimonials {
  background-color: var(--color-surface);
}

.testimonials__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

.testimonial {
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-md);
  padding: 2rem;
  background-color: var(--color-bg);
}

.testimonial__quote {
  font-family: var(--font-serif);
  font-size: 1rem;
  color: var(--color-text);
  line-height: 1.75;
  margin-bottom: 1.5rem;
  font-style: italic;
}

.testimonial__footer {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.testimonial__author {
  font-size: 0.875rem;
  color: var(--color-text);
  font-weight: 500;
}

.testimonial__location {
  font-size: 0.7rem;
  color: var(--color-accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* ——— Contact CTA ——— */
.contact-cta {
  text-align: center;
}

.contact-cta__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact-cta__label {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 1.5rem;
}

.contact-cta__title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 400;
  color: var(--color-text);
  margin-bottom: 1.25rem;
}

.contact-cta__subtitle {
  color: var(--color-muted);
  font-size: 1rem;
  margin-bottom: 2.5rem;
  line-height: 1.7;
  max-width: 44ch;
}
</style>
