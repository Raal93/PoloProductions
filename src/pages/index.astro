---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Promise from '../components/Promise.astro';
import FeaturedFilms from '../react/FeaturedFilms';
import Services from '../components/Services.astro';
import ProcessSection from '../components/ProcessSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactCTA from '../components/ContactCTA.astro';
import '../styles/featured-films.css';
---

<MainLayout title="Polo Productions — Cinematic Wedding Films">
  <Hero />
  <Promise />
  <FeaturedFilms client:load />
  <Services />
  <ProcessSection />
  <TestimonialsSection />
  <AboutSection />
  <ContactCTA />
</MainLayout>
